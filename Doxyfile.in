PROJECT_NAME           = "Z / libzlang"
PROJECT_NUMBER         = @ZLANG_PROJECT_VERSION@
PROJECT_BRIEF          = "C99 runtime library and the Zlang @ZLANG_LANGUAGE_VERSION@ source-to-source compiler"

OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = docs include @ZLANG_GENERATED_INCLUDE_DIR@ compiler/include compiler/src tools
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/index.md
STRIP_FROM_PATH        = include compiler/include tools
FULL_PATH_NAMES        = NO

EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

HAVE_DOT               = NO
