import { write } from "@std/io";

function main(): int32 {
    array[6] int32 values = {5, 1, 4, 2, 8, 3};

    for (int32 pass = 0; pass < 5; pass += 1) {
        for (int32 index = 0; index < 5 - pass; index += 1) {
            if (values[index] > values[index + 1]) {
                int32 temporary = values[index];
                values[index] = values[index + 1];
                values[index + 1] = temporary;
            }
        }
    }

    foreach (value in values) {
        write(value);
        write(" ");
    }
    write("\n");

    return 0;
}
