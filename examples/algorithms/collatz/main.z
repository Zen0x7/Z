import { write } from "@std/io";

function main(): int32 {
    int32 value = 27;
    int32 steps = 0;

    while (value != 1) {
        if (value % 2 == 0) {
            value = value / 2;
        } else {
            value = 3 * value + 1;
        }
        steps += 1;
    }

    write(steps);
    write("\n");

    return 0;
}
