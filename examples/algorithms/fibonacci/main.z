import { write } from "@std/io";

function main(): int32 {
    array[10] int32 fib = {0, 1};

    for (int32 index = 2; index < 10; index += 1) {
        fib[index] = fib[index - 1] + fib[index - 2];
    }

    foreach (value in fib) {
        write(value);
        write(" ");
    }
    write("\n");

    return 0;
}
