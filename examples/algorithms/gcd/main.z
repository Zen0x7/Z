import { write } from "@std/io";
function gcd(clone integer left, clone integer right): integer {
    while (right != 0) {
        integer remainder = left % right;
        left = right;
        right = remainder;
    }
    return left;
}

function main(): integer {
    write(gcd(1071, 462));
    write("\n");

    return 0;
}
