import { write } from "@std/io";
function gcd(clone int32 left, clone int32 right): int32 {
    while (right != 0) {
        int32 remainder = left % right;
        left = right;
        right = remainder;
    }
    return left;
}

function main(): int32 {
    write(gcd(1071, 462));
    write("\n");

    return 0;
}
