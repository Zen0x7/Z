import { write } from "@std/io";

function main(): int32 {
    array[2][2] int32 left = {{1, 2}, {3, 4}};
    array[2][2] int32 right = {{5, 6}, {7, 8}};
    array[2][2] int32 result;

    for (int32 row = 0; row < 2; row += 1) {
        for (int32 column = 0; column < 2; column += 1) {
            int32 cell = 0;
            for (int32 inner = 0; inner < 2; inner += 1) {
                cell += left[row][inner] * right[inner][column];
            }
            result[row][column] = cell;
        }
    }

    foreach (row, column in result) {
        write(result[row][column]);
        write(" ");
    }
    write("\n");

    return 0;
}
