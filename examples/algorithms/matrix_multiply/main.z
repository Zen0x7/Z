import { write } from "@std/io";

function main(): integer {
    array[2][2] integer left = {{1, 2}, {3, 4}};
    array[2][2] integer right = {{5, 6}, {7, 8}};
    array[2][2] integer result;

    for (integer row = 0; row < 2; row += 1) {
        for (integer column = 0; column < 2; column += 1) {
            integer cell = 0;
            for (integer inner = 0; inner < 2; inner += 1) {
                cell += left[row][inner] * right[inner][column];
            }
            result[row][column] = cell;
        }
    }

    foreach (row, column in result) {
        write(result[row][column]);
        write(" ");
    }
    write("\n");

    return 0;
}
