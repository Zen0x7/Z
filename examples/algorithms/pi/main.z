import { write } from "@std/io";

function main(): int32 {
    int32 scale = 100000;
    int32 total = 0;
    int32 denominator = 1;
    boolean add_term = true;

    for (int32 index = 0; index < 200000; index += 1) {
        if (add_term) {
            total += (4 * scale) / denominator;
        } else {
            total -= (4 * scale) / denominator;
        }
        denominator += 2;
        add_term = !add_term;
    }

    write(total / scale);
    write(".");
    write(total % scale);
    write("\n");

    return 0;
}
