import { write } from "@std/io";

function main(): int32 {
    array[30] boolean prime;

    for (int32 index = 0; index < 30; index += 1) {
        prime[index] = true;
    }
    prime[0] = false;
    prime[1] = false;

    for (int32 candidate = 2; candidate < 30; candidate += 1) {
        if (prime[candidate]) {
            for (int32 multiple = candidate * candidate; multiple < 30; multiple += candidate) {
                prime[multiple] = false;
            }
        }
    }

    for (int32 index = 0; index < 30; index += 1) {
        if (prime[index]) {
            write(index);
            write(" ");
        }
    }
    write("\n");

    return 0;
}
