import { write } from "@std/io";

function main(): int32 {
    int32 left = 10;
    int32 right = 3;
    uint32 count = 5U;

    int32 sum = left + right;
    int32 difference = left - right;
    int32 product = left * right;
    int32 quotient = left / right;
    int32 remainder = left % right;
    uint32 grown = count + 2U;
    int32 negative = -sum;

    left += right;
    left -= right;
    left *= right;
    left /= right;
    left %= right;

    write(sum);
    write(" ");
    write(difference);
    write(" ");
    write(product);
    write(" ");
    write(quotient);
    write(" ");
    write(remainder);
    write(" ");
    write(grown);
    write(" ");
    write(negative);
    write(" ");
    write(left);
    write("\n");

    return 0;
}
