import { write } from "@std/io";

function main(): int32 {
    array[5] int32 values = {4, 5};
    int32 capacity = 5;

    values[0] = values[1] + 1;
    values[2] = values[0] * 2;
    values[3] = values[2] - 1;
    values[4] = values[3] + capacity;

    foreach (value in values) {
        write(value);
        write(" ");
    }
    write("\n");

    return 0;
}
