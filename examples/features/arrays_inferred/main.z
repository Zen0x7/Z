import { write } from "@std/io";

function main(): int32 {
    array[] int32 flat = {1, 2, 3};
    array int32 grid = {{1, 2}, {3, 4}};

    uint32 flat_length = length(flat);
    uint32 grid_length = length(grid);

    grid[1][1] = flat[2] + grid[0][1];

    write(flat_length);
    write(" ");
    write(grid_length);
    write(" ");
    write(grid[1][1]);
    write("\n");

    return 0;
}
