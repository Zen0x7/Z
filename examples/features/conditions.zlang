integer value = 2;
boolean ready = true;

if (value == 1) {
    print("one");
} else if (value == 2) {
    print("two");
} else {
    print("other");
}

print(" ");
print(ready && value == 2);
print(" ");
print(!ready || value == 2);
print(" ");
print(value < 3 && value >= 2);
print(" ");
print(value != 2 || !(value > 10));
print("\n");
