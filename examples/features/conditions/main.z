import { write } from "@std/io";

function main(): int32 {
    int32 value = 2;
    boolean ready = true;

    if (value == 1) {
        write("one");
    } else if (value == 2) {
        write("two");
    } else {
        write("other");
    }

    write(" ");
    write(ready && value == 2);
    write(" ");
    write(!ready || value == 2);
    write(" ");
    write(value < 3 && value >= 2);
    write(" ");
    write(value != 2 || !(value > 10));
    write("\n");

    return 0;
}
