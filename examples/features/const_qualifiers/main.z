import { write } from "@std/io";
struct Point {
    integer x;
}

function read(const reference Point point): integer {
    return point.x;
}

function copy_value(const clone integer value): integer {
    return value;
}

function main(): integer {
    Point point;
    point.x = 6;

    write(read(point));
    write(" ");
    write(copy_value(point.x));
    write("\n");

    return 0;
}
