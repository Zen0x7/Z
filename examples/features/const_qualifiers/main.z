import { write } from "@std/io";
struct Point {
    int32 x;
}

function read(const reference Point point): int32 {
    return point.x;
}

function copy_value(const clone int32 value): int32 {
    return value;
}

function main(): int32 {
    Point point;
    point.x = 6;

    write(read(point));
    write(" ");
    write(copy_value(point.x));
    write("\n");

    return 0;
}
