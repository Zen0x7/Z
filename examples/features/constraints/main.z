import { write } from "@std/io";

interface Labeled {
    function label(): int32;
}

struct Counter implements Labeled {
    int32 value;

    constructor(clone int32 initial) {
        value = initial;
    }

    function label(): int32 {
        return value;
    }
}

function show<T implements { Labeled }>(clone T item): int32 {
    return item.label();
}

function main(): int32 {
    Counter counter = Counter(7);
    write(show<Counter>(counter));
    write("\n");
    return 0;
}
