import { write } from "@std/io";
function add(clone int32 left, clone int32 right): int32 {
    return left + right;
}

function bump(reference int32 value) {
    value += 1;
}

function main(): int32 {
    int32 total = add(2, 3);
    bump(total);

    write(total);
    write("\n");

    return 0;
}
