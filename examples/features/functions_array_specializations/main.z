import { write } from "@std/io";
function first(clone array source): int32 {
    return source[0];
}

function main(): int32 {
    array[2][3] int32 grid;
    grid[0][0] = 7;
    array[4] int32 line;
    line[0] = 9;

    write(first(grid));
    write(" ");
    write(first(line));
    write("\n");

    return 0;
}
