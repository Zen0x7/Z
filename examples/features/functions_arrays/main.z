import { write } from "@std/io";
function stamp(clone array source): array {
    array result;
    result[0][1] = source[0][1] + 1;
    return result;
}

function main(): int32 {
    array[2][3] int32 grid;
    grid[0][1] = 5;
    array[2][3] int32 stamped = stamp(grid);

    write(stamped[0][1]);
    write("\n");

    return 0;
}
