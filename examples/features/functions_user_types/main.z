import { write } from "@std/io";
struct Point {
    int32 x;
}

function make(): Point {
    Point result;
    result.x = 1;
    return result;
}

function shift(reference Point point, clone int32 amount) {
    point.x = point.x + amount;
}

function main(): int32 {
    Point point = make();
    shift(point, 4);

    write(point.x);
    write("\n");

    return 0;
}
