import { write } from "@std/io";
record Point {
    integer x;
}

function make(): Point {
    Point result;
    result.x = 1;
    return result;
}

function shift(reference Point point, clone integer amount) {
    point.x = point.x + amount;
}

function main(): integer {
    Point point = make();
    shift(point, 4);

    write(point.x);
    write("\n");

    return 0;
}
