import { write } from "@std/io";

trait Named requires int32 value {
    function label(): int32 {
        return value;
    }
}

struct Shape uses Named {
    int32 value;

    constructor(clone int32 initial) {
        value = initial;
    }

    function area(): int32 {
        return value;
    }
}

struct Square : Shape {
    int32 side;

    constructor(clone int32 initial, clone int32 side_value) {
        side = side_value;
        value = initial;
    }

    function area(): int32 {
        return side * side;
    }
}

function describe(reference Shape shape): int32 {
    return shape.area();
}

function main(): int32 {
    Shape base = Shape(2);
    Square square = Square(3, 4);
    write(describe(base));
    write(" ");
    write(describe(square));
    write(" ");
    write(base.label());
    write(" ");
    write(square.label());
    write("\n");
    return 0;
}
