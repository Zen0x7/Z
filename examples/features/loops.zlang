integer total = 0;

while (total < 2) {
    total += 1;
}

repeat (2U) {
    total += 1;
}

for (integer index = 0; index < 3; index += 1) {
    if (index == 1) {
        continue;
    }
    total += index;
}

array[4] integer values = {1, 2, 3, 4};
foreach (value in values) {
    if (value == 3) {
        break;
    }
    total += value;
}

foreach (index, item in values) {
    print(index);
    print(":");
    print(item);
    print(" ");
}

print(total);
print("\n");
