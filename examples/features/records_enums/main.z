import { write } from "@std/io";
struct Point {
    integer x;
    integer y;
}

enum Color {
    RED,
    GREEN,
    BLUE
}

function main(): integer {
    Point point;
    point.x = 3;
    point.y = 4;
    Color color = BLUE;

    write(point.x);
    write(" ");
    write(point.y);
    write(" ");
    write(to_integer(color));
    write("\n");

    return 0;
}
