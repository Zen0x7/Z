import { write } from "@std/io";
struct Point {
    int32 x;
    int32 y;
}

enum Color {
    RED,
    GREEN,
    BLUE
}

function main(): int32 {
    Point point;
    point.x = 3;
    point.y = 4;
    Color color = BLUE;

    write(point.x);
    write(" ");
    write(point.y);
    write(" ");
    write(to_int32(color));
    write("\n");

    return 0;
}
