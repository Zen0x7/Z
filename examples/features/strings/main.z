import { write } from "@std/io";

function main(): integer {
    string folded = "z" + "lang";
    string[32] bounded = folded + " tour";
    unsigned first = bounded[0];
    string[8] letter = "abc";
    letter = "z";

    write(folded);
    write(" ");
    write(bounded);
    write(" ");
    write(first);
    write(" ");
    write(letter);
    write("\n");

    return 0;
}
