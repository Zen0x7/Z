import { write } from "@std/io";

struct Counter {
    int32 value;

    constructor(clone int32 initial) {
        value = initial;
    }

    function increment(): int32 {
        value += 1;
        return value;
    }

    static function zero(): Counter {
        return Counter(0);
    }
}

function main(): int32 {
    Counter counter = Counter(1);
    write(counter.increment());
    write(" ");
    write(counter.increment());
    write("\n");
    Counter empty = Counter.zero();
    write(empty.value);
    write("\n");
    return 0;
}
