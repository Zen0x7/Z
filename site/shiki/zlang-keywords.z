// keyword and scope coverage fixture
/* block comment */
import { write, read, read_line } from "@std/io";
import { abs, clamp, min, max, sqrt } from "@std/math";
import { generate_int32, generate_uint32 } from "@std/random";

const int32 base = 10;
uint32 count = 3U;
int64 wide = 9i64;
uint64 huge = 18u64;
float ratio = 0.5f;
double precise = 1.25;
boolean ready = true;
string greeting = "hello" + " world";
string[32] bounded = greeting + "!";
array[4] int32 values = {1, 2, 3, 4};
array[2][2] uint32 grid = {{1u, 2u}, {3u, 4u}};

enum Color {
    RED, GREEN, BLUE
}

trait Named requires string label {
    function name(): string {
        return label;
    }
}

struct Shape uses Named {
    string label;
    int32 value;

    constructor(clone int32 initial, clone string text) {
        value = initial;
        label = text;
    }

    function area(): int32 {
        return value;
    }
}

struct Square : Shape {
    int32 side;

    constructor(clone int32 size, clone string text) {
        side = size;
        value = size;
        label = text;
    }

    function area(): int32 {
        return side * side;
    }

    static function unit(): Square {
        return Square(1, "unit");
    }
}

struct Pair<T, U> {
    T first;
    U second;
}

function identity<T>(clone T item): T {
    return item;
}

function add(const clone int32 left, clone int32 right): int32 {
    return left + right;
}

function peek(const reference string text): string {
    return text;
}

function describe(reference Shape shape): string {
    return shape.name();
}

function main(int32 argc, arguments argv): int32 {
    int32 total = base;
    Pair<int32, boolean> pair;
    pair.first = total;
    pair.second = ready;

    total = abs(total);
    total = clamp(total, 0, 10);
    count = generate_uint32(1u, 6u);
    wide = to_int64(total);
    huge = to_uint64(total);
    ratio = to_float(total);
    precise = to_double(total);

    string[64] input;
    int32 read_count = read(input);
    int32 line_count = read_line(input);

    if (ready && total < 10 || !pair.second) {
        total += 1;
    } else if (count > 1U) {
        total -= 1;
    } else {
        total *= 2;
    }

    while (total > 0) {
        if (total == 2) {
            continue;
        }
        if (total >= 8) {
            break;
        }
        total /= 2;
    }

    for (int32 index = 0; index < 4; index += 1) {
        values[index] = values[index] + index;
    }

    foreach (value in values) {
        total += value;
    }

    foreach (row, col in grid) {
        total += to_int32(grid[row][col]);
    }

    foreach (index, item in values) {
        write(index);
        write(item);
    }

    repeat (2U) {
        total %= 3;
    }

    write(bounded);
    write(length(values));
    write(identity<int32>(total));
    write(describe(Square.unit()));
    write(COLOR_RED);
    write(STATUS_SUCCESS);
    return total;
}
