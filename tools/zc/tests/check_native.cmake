if(NOT ZLANG_COMPILE OR NOT SOURCE OR NOT EXPECTED OR NOT WORK_DIR OR NOT C_COMPILER OR NOT C_COMPILER_ID)
    message(FATAL_ERROR "check_native.cmake requires ZLANG_COMPILE, SOURCE, EXPECTED, WORK_DIR, C_COMPILER and C_COMPILER_ID")
endif()
get_filename_component(_stem "${SOURCE}" NAME_WE)
get_filename_component(_project_dir "${SOURCE}" DIRECTORY)
set(_source "${WORK_DIR}/${_stem}.z")
set(_executable "${WORK_DIR}/${_stem}")
file(MAKE_DIRECTORY "${WORK_DIR}")
file(COPY "${_project_dir}/" DESTINATION "${WORK_DIR}")
if(C_COMPILER_ID MATCHES "MSVC")
    file(WRITE "${WORK_DIR}/z.yaml" "native:\n  my_math:\n    header: \"./native/my_math.h\"\n    include_dirs:\n      - \"./native\"\n    sources:\n      - \"./native/my_math.c\"\n")
else()
    file(WRITE "${WORK_DIR}/z.yaml" "native:\n  my_math:\n    header: \"./native/my_math.h\"\n    include_dirs:\n      - \"./native\"\n    sources:\n      - \"./native/my_math.c\"\n    libraries:\n      - \"m\"\n    link_flags:\n      - \"-Wl,-z,now\"\n")
endif()
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env "ZLANG_CC=${C_COMPILER}" "${ZLANG_COMPILE}" "${_stem}.z"
    WORKING_DIRECTORY "${WORK_DIR}"
    RESULT_VARIABLE _compile OUTPUT_VARIABLE _compile_output ERROR_VARIABLE _error)
if(NOT _compile EQUAL 0)
    message(FATAL_ERROR "zc failed: ${_error}${_compile_output}")
endif()
execute_process(COMMAND "${_executable}" WORKING_DIRECTORY "${WORK_DIR}"
                RESULT_VARIABLE _run OUTPUT_VARIABLE _actual ERROR_VARIABLE _error)
if(NOT _run EQUAL 0)
    message(FATAL_ERROR "program failed with status ${_run}: ${_error}")
endif()
file(READ "${EXPECTED}" _expected)
if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "output mismatch\n--- expected ---\n${_expected}\n--- actual ---\n${_actual}")
endif()
file(READ "${WORK_DIR}/${_stem}.c" _generated)
string(FIND "${_generated}" "#include \"native/my_math.h\"" _position)
if(_position LESS 0)
    message(FATAL_ERROR "generated C does not include the native header with quotes")
endif()
string(FIND "${_generated}" "my_add(" _call_position)
if(_call_position LESS 0)
    message(FATAL_ERROR "generated C does not call the native function")
endif()
