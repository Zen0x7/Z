import { write } from "@std/io";
const integer base = 2;
array[] integer values = {1, 2, 3};
array[5] integer fixed = {4, 5};
fixed[0] = values[1];
string message = "temp_" + "_01";
string[32] label = message + "sensor";
label = label + "!";
boolean a = true;
boolean b = false;
boolean ok = !(a && b) || a;
if (ok) {
    write("yes");
} else if (b) {
    write("no");
} else {
    write("maybe");
}
foreach (item in values) {
    if (item == 2) {
        continue;
    }
    if (item == 3) {
        break;
    }
    write("kept");
}
while (a) {
    break;
}
repeat(2U) { continue; }
function add(clone integer left, clone integer right) : integer { return left + right; }
integer total = add(1, base);
for (unsigned outer = 0U; outer < 2U; outer += 1U) {
    for (unsigned inner = 0U; inner < 2U; inner += 1U) {
        write(outer);
        write(inner);
    }
}
foreach (row, item in values) {
    foreach (column, other in values) {
        write(row);
        write(column);
        write(item);
        write(other);
    }
}
string[8] text = "abc";
unsigned first = text[0];
write(first);
