import { read, read_line, write } from "@std/io";

function main(): int32 {
    string[16] line;
    Result<int32, Status> first = read_line(line);
    write(line);
    write("|");
    write(first.value);
    write("\n");

    string[16] raw;
    Result<int32, Status> second = read(raw);
    write(raw);
    write("|");
    write(second.value);
    write("\n");
    return 0;
}
