import { write } from "@std/io";
import { retries } from "@lib/config";
import { add_one, zero } from "./lib/math";
import { left_value } from "./lib/left";
import { right_value } from "./lib/right";
import { Point, Color } from "@lib/types";

function main(integer argc, arguments argv): integer {
    Point point;
    point.x = add_one(retries);
    point.y = 1;
    Color color = BLUE;
    write(point.x);
    write(" ");
    write(to_integer(color));
    write(" ");
    write(zero());
    write(" ");
    write(left_value());
    write(" ");
    write(right_value());
    write("\n");
    return 0;
}
