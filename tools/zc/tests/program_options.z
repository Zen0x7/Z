import { write } from "@std/io";
import { argument_count, argument_at, has_option, option_value, has_flag } from "@std/program_options";

function main(integer argc, arguments argv): integer {
    write(argument_count(argv));
    write(" ");
    write(argument_at(argv, 1U));
    write(" ");
    write(has_option(argv, "--name"));
    write(" ");
    write(option_value(argv, "--name"));
    write(" ");
    write(has_flag(argv, "--verbose"));
    write("\n");
    return 0;
}
