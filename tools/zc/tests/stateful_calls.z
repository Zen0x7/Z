import { write } from "@std/io";
import { generate_int32 } from "@std/random";

function pure_add(clone integer left, clone integer right): integer {
    return left + right;
}

function rolls(): integer {
    return generate_int32(1, 6);
}

function rolls_twice(): integer {
    return rolls() + rolls();
}

integer a = pure_add(1, 2);
integer b = rolls_twice();
write(a);
write(" ");
write(b);
write("\n");
