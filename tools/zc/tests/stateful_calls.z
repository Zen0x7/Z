import { write } from "@std/io";
import { generate_int32 } from "@std/random";

function pure_add(clone int32 left, clone int32 right): int32 {
    return left + right;
}

function rolls(): int32 {
    result_type<int32, status_code> _roll = generate_int32(1, 6);
    return _roll.get();
}

function rolls_twice(): int32 {
    return rolls() + rolls();
}

int32 a = pure_add(1, 2);
int32 b = rolls_twice();
write(a);
write(" ");
write(b);
write("\n");
