struct Point {
    integer x;
    integer y;
}
enum Color {
    RED,
    BLUE
}
function make(): Point {
    Point result;
    result.x = 1;
    result.y = 2;
    return result;
}
function paint(clone Point value, clone Color color): Point {
    value.x = 2;
    return value;
}
function shift(reference Point point, clone integer amount) {
    point.x = point.x + amount;
}
Point made = make();
Color chosen = BLUE;
Point painted = paint(made, chosen);
shift(made, 3);
